{
  "name": "selfevopi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Harness auto-evolutivo, leve e Windows-nativo sobre o PI Coding Agent",
  "engines": {
    "node": ">=22.19.1"
  },
  "scripts": {
    "test": "node --test core/router/router.test.mjs",
